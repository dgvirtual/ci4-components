{
  "name": "dgvirtual/codeigniter4-components",
  "description": "Codeigniter 4 Components library which allows creating custom HTML elements to use within view files",
  "keywords": [
    "CodeIgniter",
    "CodeIgniter4",
    "Components",
    "Bonfire",
    "Decorator"
  ],
  "type": "library",
  "homepage": "https://github.com/dgvirtual/ci4-components",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.0"
  },
  "require-dev": {
    "codeigniter4/devkit": "^1.0",
    "codeigniter4/framework": "^4.3"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Dgvirtual\\Components\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests",
      "Tests\\Support\\": "tests/_support"
    }
  },
  "authors": [
    {
      "name": "Donatas Glodenis",
      "email": "dg@lapas.info"
    }
  ],
  "scripts": {
    "analyze": "vendor/bin/phpstan analyze",
    "rector": "vendor/bin/rector process --dry-run",
    "rector-fix": "vendor/bin/rector process",
    "style": "vendor/bin/php-cs-fixer fix --ansi --verbose --dry-run --diff",
    "style-fix": "vendor/bin/php-cs-fixer fix --ansi --verbose --diff",
    "cs": "@style-fix",
    "test": "export XDEBUG_MODE=coverage; vendor/bin/phpunit"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}